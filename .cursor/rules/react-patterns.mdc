## React Query Hooks

```typescript
// ✅ GOOD - Hook de query tipado
import { useQuery } from '@tanstack/react-query';
import { apiClient } from '../utils/api';

export interface Transaction {
  id: string;
  amount: number;
  description: string;
}

export interface ListTransactionsParams {
  householdId?: string;
  cursor?: string;
  limit?: number;
}

export function useTransactions(params: ListTransactionsParams) {
  return useQuery({
    queryKey: ['transactions', params],
    queryFn: () => apiClient.get<Transaction[]>('/transactions', { params }),
    enabled: !!params.householdId, // Só busca se tiver householdId
    staleTime: 5 * 60 * 1000, // 5 minutos
  });
}

// ✅ GOOD - Mutation com invalidação
export function useCreateTransaction() {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: (data: CreateTransactionInput) =>
      apiClient.post('/transactions', data),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['transactions'] });
      queryClient.invalidateQueries({ queryKey: ['accounts'] });
    },
  });
}
```

## Formulários

```typescript
// ✅ GOOD - React Hook Form + Zod
import { useForm, Controller } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';

const schema = z.object({
  name: z.string().min(1, 'Nome é obrigatório'),
  amount: z.number().positive('Valor deve ser positivo'),
  date: z.date(),
});

type FormData = z.infer<typeof schema>;

export function TransactionForm() {
  const { control, handleSubmit, formState: { errors, isSubmitting } } = useForm<FormData>({
    resolver: zodResolver(schema),
    defaultValues: {
      date: new Date(),
    },
  });
  
  const mutation = useCreateTransaction();
  
  const onSubmit = async (data: FormData) => {
    await mutation.mutateAsync(data);
  };
  
  return (
    <form onSubmit={handleSubmit(onSubmit)}>
      <Controller
        name="name"
        control={control}
        render={({ field }) => (
          <Input {...field} error={errors.name?.message} />
        )}
      />
      <Button type="submit" disabled={isSubmitting}>
        Salvar
      </Button>
    </form>
  );
}
```

